{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "context-mode",
    "@dietrichgebert/ponytail"
  ],
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "tools": {
    "todowrite": false
  },
  "lsp": {
    "eslint": {
      "disabled": true
    }
  },
  "mcp": {
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "/Users/dan/.local/bin/codebase-memory-mcp"
      ]
    }
  }
}